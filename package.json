{
  "name": "vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "playwright test --project=e2e",
    "agent:build": "npm --prefix agent run build",
    "agent:test": "npm --prefix agent test",
    "e2e:a11y": "playwright test --project=e2e e2e/a11y.e2e.ts",
    "perf": "playwright test --project=perf --workers=1",
    "gen:board": "tsx scripts/gen-board.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "ci": "npm run lint && npm run build && npm test && npm run typecheck:e2e && npm --prefix agent run typecheck && npm --prefix agent test && npm run e2e && npm run perf"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/sofia-sans-semi-condensed": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.1.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
