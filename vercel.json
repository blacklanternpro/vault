{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?op=prm" },
    { "source": "/.well-known/oauth-protected-resource/:rest*", "destination": "/api/oauth?op=prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?op=as" },
    { "source": "/.well-known/oauth-authorization-server/:rest*", "destination": "/api/oauth?op=as" },
    { "source": "/register", "destination": "/api/oauth?op=register" },
    { "source": "/authorize", "destination": "/api/oauth?op=authorize" },
    { "source": "/token", "destination": "/api/oauth?op=token" }
  ]
}
